{
  "manifest_version": 3,
  "name": "Test Extension",
  "version": "0.1.0",
  "description": "A minimal extension scaffold",
  "background": {
    "service_worker": "src/background/background.ts"
  },
  "permissions": ["contextMenus", "storage", "tabs", "activeTab"],
  "action": {},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/background/content/content.ts"]
    }
  ]
  ,
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
